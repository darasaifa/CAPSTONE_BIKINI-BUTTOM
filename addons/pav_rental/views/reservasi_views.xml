<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Daftar reservasi -->
    <record id="pav_rental_reservasi_view_list" model="ir.ui.view">
        <field name="name">pav.rental.reservasi.list</field>
        <field name="model">pav.rental.reservasi</field>
        <field name="arch" type="xml">
            <list string="Reservasi"
                  decoration-info="state == 'confirmed'"
                  decoration-success="state == 'ongoing'"
                  decoration-muted="state in ('done', 'cancel')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <field name="tanggal_mulai"/>
                <field name="tanggal_selesai"/>
                <field name="paket"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="total" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'ongoing'"
                       decoration-muted="state in ('done', 'cancel')"/>
            </list>
        </field>
    </record>

    <!-- Formulir reservasi -->
    <record id="pav_rental_reservasi_view_form" model="ir.ui.view">
        <field name="name">pav.rental.reservasi.form</field>
        <field name="model">pav.rental.reservasi</field>
        <field name="arch" type="xml">
            <form string="Reservasi">
                <header>
                    <button name="action_konfirmasi" string="Konfirmasi" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_mulai_sewa" string="Serahkan Motor" type="object"
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_selesai" string="Motor Kembali" type="object"
                            class="oe_highlight" invisible="state != 'ongoing'"/>
                    <button name="action_batal" string="Batalkan" type="object"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_kembali_draft" string="Jadikan Draf" type="object"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,ongoing,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Pemesanan">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="vehicle_id" readonly="state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="paket" widget="radio" options="{'horizontal': true}"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group string="Jadwal">
                            <field name="tanggal_mulai" readonly="state != 'draft'"/>
                            <field name="tanggal_selesai" readonly="state != 'draft'"/>
                            <field name="jumlah_hari"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rincian Biaya" name="biaya">
                            <group>
                                <group>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="tarif" readonly="state != 'draft'"/>
                                    <field name="biaya_sewa"/>
                                    <field name="antar_jemput" readonly="state != 'draft'"/>
                                    <field name="biaya_antar" invisible="not antar_jemput"
                                           readonly="state != 'draft'"/>
                                    <field name="total"/>
                                </group>
                            </group>
                        </page>
                        <!-- TODO Farisha (iterasi 2): halaman Serah Terima dan Pengembalian -->
                        <page string="Catatan" name="catatan">
                            <field name="catatan" placeholder="Catatan tambahan untuk reservasi ini"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kalender sewa: melihat motor mana terpakai di tanggal berapa -->
    <record id="pav_rental_reservasi_view_calendar" model="ir.ui.view">
        <field name="name">pav.rental.reservasi.calendar</field>
        <field name="model">pav.rental.reservasi</field>
        <field name="arch" type="xml">
            <calendar string="Kalender Sewa" date_start="tanggal_mulai" date_stop="tanggal_selesai"
                      color="vehicle_id" mode="month" quick_create="False" event_open_popup="True">
                <field name="partner_id"/>
                <field name="vehicle_id" filters="1"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Pencarian dan filter -->
    <record id="pav_rental_reservasi_view_search" model="ir.ui.view">
        <field name="name">pav.rental.reservasi.search</field>
        <field name="model">pav.rental.reservasi</field>
        <field name="arch" type="xml">
            <search string="Cari Reservasi">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="vehicle_id"/>
                <filter name="aktif" string="Aktif (Dikonfirmasi/Disewa)"
                        domain="[('state', 'in', ('confirmed', 'ongoing'))]"/>
                <filter name="draf" string="Draf" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter name="group_vehicle" string="Motor" context="{'group_by': 'vehicle_id'}"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="pav_rental_reservasi_action" model="ir.actions.act_window">
        <field name="name">Reservasi</field>
        <field name="res_model">pav.rental.reservasi</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada reservasi</p>
            <p>Klik Baru untuk mencatat pemesanan motor.</p>
        </field>
    </record>

</odoo>
