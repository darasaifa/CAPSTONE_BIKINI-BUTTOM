        </record>
        <record id="motor_contoh_beat_2014" model="fleet.vehicle">
            <field name="rental_tarif_harian">85000</field>
            <field name="rental_tarif_mingguan">510000</field>
            <field name="rental_minimal_hari">2</field>
        </record>
        <record id="motor_contoh_genio" model="fleet.vehicle">
            <field name="rental_tarif_harian">110000</field>
            <field name="rental_tarif_mingguan">660000</field>
        </record>
        <record id="motor_contoh_mio_gear" model="fleet.vehicle">
            <field name="rental_tarif_harian">100000</field>
            <field name="rental_tarif_mingguan">600000</field>
        </record>
        <record id="motor_contoh_nmax" model="fleet.vehicle">
            <field name="rental_tarif_harian">150000</field>
            <field name="rental_tarif_mingguan">900000</field>
