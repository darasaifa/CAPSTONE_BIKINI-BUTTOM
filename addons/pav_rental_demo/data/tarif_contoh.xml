<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--
        Tarif CONTOH untuk motor fiktif di armada_contoh.xml.
        Kisaran Rp85.000 s.d. Rp150.000 per hari mengikuti Bab I proposal;
        tarif mingguan sementara 6 x tarif harian sampai daftar harga mitra masuk.
        noupdate="0" supaya tarif ini juga masuk ke database yang sudah memasang
        Data Contoh sebelumnya (cukup Upgrade modul).
    -->
    <data noupdate="0">
        <record id="motor_contoh_scoopy" model="fleet.vehicle">
            <field name="rental_tarif_harian">110000</field>
